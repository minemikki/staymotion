{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/reel.js": {
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "api/ingest-generation.js": {
      "includeFiles": "node_modules/ffmpeg-static/**",
      "maxDuration": 300
    },
    "api/admin-production.js": {
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "api/mcp.js": {
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "api/mcp/[key].js": {
      "includeFiles": "node_modules/ffmpeg-static/**"
    }
  },
  "headers": [
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(og.jpg|favicon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
