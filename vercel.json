{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(og.jpg|favicon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sales-cron",
      "schedule": "*/30 7-15 * * 1-5"
    }
  ]
}
