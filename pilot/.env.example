# ---- Data mode ----
# Leave the Supabase variables empty to run in local/demo mode (browser storage, seeded data).
# Set NEXT_PUBLIC_STAYMOTION_MODE=local to force local mode even when Supabase vars exist.
NEXT_PUBLIC_STAYMOTION_MODE=

# ---- Supabase (real pilot mode) — browser-safe values only ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server-only (never NEXT_PUBLIC_) ----
# Used by the follow-up cron route (/api/followup) and future server jobs. Never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=
FOLLOWUP_CRON_SECRET=

# ---- AI (server-only). Empty → deterministic local rules adapter, clearly labelled in the UI. ----
AI_EXTRACTION_KEY=
AI_EXTRACTION_MODEL=

# Conservative worst-case estimate reserved BEFORE a paid extraction call is allowed.
# Migration 0003 also enforces default per-user 30 requests / 10 min and per-org 25 NOK/day.
# Organization settings can later override those two quotas under settings.aiLimits.
AI_EXTRACTION_MAX_COST_NOK_PER_REQUEST=0.25
