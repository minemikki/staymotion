{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/nettside-for-restaurant",
      "destination": "/nettside-restaurant",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/salg",
      "destination": "/sales-hub.html"
    }
  ],
  "headers": [
    {
      "source": "/(og.jpg|favicon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
